{%- style -%}
  #shopify-section-{{ section.id }} .mts-our-people-video-display {
    padding: 64px 0;
    display: flex;
    flex-direction: column;
    background: rgb(93, 108, 127);
    color: #ffffff;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 18px;
    text-wrap: pretty;
    line-height: 1.25;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .mts-our-people-video-display .page-width {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mts-our-people-video-display h2 {
    font-size: inherit;
    font-weight: inherit;
    margin: 0;
    font-family: inherit;
    line-height: inherit;
  }

  #shopify-section-{{ section.id }} .mts-our-people-video-display media-theme-sutro {
    --media-primary-color: #F9F9F9;
    width: 90%;
    border-radius: 12px !important;
    margin: 16px auto 0 auto;
  }

  #shopify-section-{{ section.id }} .mts-our-people-video-display youtube-video {
    min-height: 400px;
    border-radius: 12px !important;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-our-people-video-display youtube-video {
      min-height: 240px;
    }
  }
{%- endstyle -%}

<div class="mts-our-people-video-display" role="region" aria-labelledby="mts-our-people-video-heading-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 id="mts-our-people-video-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.youtube_url != blank %}
      <script type="module" src="https://cdn.jsdelivr.net/npm/youtube-video-element/+esm"></script>
      <script type="module" src="https://cdn.jsdelivr.net/npm/player.style/sutro/+esm"></script>
      <media-theme-sutro>
        <youtube-video
          slot="media"
          src="{{ section.settings.youtube_url }}"
          playsinline
          crossorigin
        ></youtube-video>
      </media-theme-sutro>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "MTS Our People — Video",
  "tag": "section",
  "class": "section-mts-our-people-video-display",
  "settings": [
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "The Computer Wore Rollerblades:<br> Mike on ABC News in 1996"
    },
    {
      "type": "video_url",
      "id": "youtube_url",
      "label": "YouTube video URL",
      "accept": ["youtube"],
      "default": "https://www.youtube.com/watch?v=hLslmilsanM"
    }
  ],
  "presets": [
    {
      "name": "MTS Our People — Video"
    }
  ]
}
{% endschema %}
