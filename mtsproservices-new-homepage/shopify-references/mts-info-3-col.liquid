{%- style -%}
  #shopify-section-{{ section.id }} {
    --mts-secondary-color: rgba(78, 168, 195, 1);
  }

  #shopify-section-{{ section.id }} .mts-info-3-col {
    padding: 64px 0;
  }

  #shopify-section-{{ section.id }} .mts-info-3-col h2 {
    font-size: 48px;
    font-weight: 700;
    font-family: 'Source Sans 3', sans-serif;
    margin: 0;
    text-wrap: pretty;
    line-height: 1;
    color: var(--mts-secondary-color);
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-info-3-col h2 {
      font-size: 42px;
    }
  }

  #shopify-section-{{ section.id }} .mts-info-3-col-content {
    display: flex;
    z-index: 1;
    flex-direction: row;
    justify-content: flex-start;
    gap: 64px;
    margin-top: 36px;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-info-3-col-content {
      flex-direction: column;
      gap: 36px;
    }
  }

  #shopify-section-{{ section.id }} .mts-info-3-col-content .col {
    flex: 1 1 0;
    width: auto;
  }

  #shopify-section-{{ section.id }} .mts-info-3-col-content .col p {
    font-size: 26px;
    font-family: 'Source Sans 3', sans-serif;
    margin: 0;
  }
{%- endstyle -%}

<div class="mts-info-3-col" role="region" aria-labelledby="mts-info-3-col-heading-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 id="mts-info-3-col-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="mts-info-3-col-content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'column' %}
            <div class="col" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <div class="rte">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Info 3 columns",
  "tag": "section",
  "class": "section-mts-info-3-col",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Your Mac Support Keeps Falling Short"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p><strong>They Say They Support Macs.<br> They Don’t.</strong></p>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Your current MSP treats your Mac fleet like a problem to solve instead of an intentional choice.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info 3 columns",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "<p><strong>They Say They Support Macs.<br> They Don’t.</strong></p>",
            "text": "<p>Your current MSP treats your Mac fleet like a problem to solve instead of an intentional choice.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "<p><strong>Too Much, Too Little</strong></p>",
            "text": "<p>You’re managing infrastructure for 500 employees with a team of three (including yourself). Meanwhile, your CEO keeps asking why IT costs so much.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "<p><strong>The Compliance Countdown</strong></p>",
            "text": "<p>Security threats evolve daily. Your Apple fleet is half-managed at best. And that audit deadline? It’s not moving.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
