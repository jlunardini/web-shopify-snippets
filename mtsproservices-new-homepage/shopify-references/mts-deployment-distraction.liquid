{%- style -%}
  #shopify-section-{{ section.id }} {
    --mts-secondary-color: rgba(78, 168, 195, 1);
  }

  #shopify-section-{{ section.id }} .mts-deployment-distraction {
    padding: 110px 0 200px 0;
    display: flex;
    flex-direction: column;
    background: var(--mts-secondary-color);
    color: #ffffff;
    position: relative;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-deployment-distraction {
      padding: 80px 0 120px 0;
    }
  }

  #shopify-section-{{ section.id }} .mts-deployment-distraction h2 {
    font-size: 48px;
    line-height: 1;
    font-weight: 700;
    margin: 0 0 24px 0;
    font-family: 'Source Sans 3', sans-serif;
    z-index: 1;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-deployment-distraction h2 {
      font-size: 42px;
    }
  }

  #shopify-section-{{ section.id }} .mts-deployment-distraction .rte {
    font-size: 26px;
    font-family: 'Source Sans 3', sans-serif;
    text-wrap: pretty;
    padding: 0 64px 0 0;
    margin: 0;
    z-index: 1;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-deployment-distraction .rte {
      padding: 0;
    }
  }

  #shopify-section-{{ section.id }} .mts-deployment-distraction .mts-deployment-distraction-button {
    display: inline-block;
    background: #ffffff;
    color: var(--mts-secondary-color);
    border: none;
    padding: 16px 32px;
    border-radius: 140px;
    cursor: pointer;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 24px;
    align-self: flex-start;
    margin-top: 24px;
    transition: background-color 0.3s ease;
    text-decoration: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .mts-deployment-distraction .mts-deployment-distraction-button:hover {
    background-color: rgba(255, 255, 255, 0.8);
  }

  #shopify-section-{{ section.id }} .mts-talos-absolute {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 10%;
    z-index: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .mts-talos-absolute img {
    height: 500px;
    width: 400px;
    object-fit: contain;
    opacity: 0.2;
  }
{%- endstyle -%}

<div class="mts-deployment-distraction" role="region" aria-labelledby="mts-deployment-heading-{{ section.id }}">
  {% if section.settings.watermark_image != blank %}
    <div class="mts-talos-absolute" aria-hidden="true">
      <img
        src="{{ section.settings.watermark_image | image_url: width: 800 }}"
        alt=""
        width="{{ section.settings.watermark_image.width }}"
        height="{{ section.settings.watermark_image.height }}"
        loading="lazy"
      >
    </div>
  {% endif %}
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 id="mts-deployment-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="rte">{{ section.settings.body }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="mts-deployment-distraction-button" href="{{ section.settings.button_link }}">
        {{- section.settings.button_label -}}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "MTS Home — Deployment / Talos",
  "tag": "section",
  "class": "section-mts-deployment-distraction",
  "settings": [
    {
      "type": "image_picker",
      "id": "watermark_image",
      "label": "Background watermark (Talos)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Eliminate Deployment Distraction"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p><strong>We Built Talos Fleet Management for Apple Devices</strong><br>Most MSPs have a couple of people who “know Jamf.” We have an entire team working exclusively in Apple enterprise for 30+ years with over 40,000 Macs in a single Jamf instance. We don’t treat Mac deployments like modified Windows projects. We treat them like the sophisticated, security-critical infrastructure they are.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More About Talos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "MTS Home — Talos"
    }
  ]
}
{% endschema %}
