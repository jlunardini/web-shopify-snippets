{%- style -%}
  #shopify-section-{{ section.id }} {
    --mts-secondary-color: rgba(78, 168, 195, 1);
    --mts-secondary-color-hover: rgba(78, 168, 195, 0.8);
  }

  #shopify-section-{{ section.id }} .mts-home-hero {
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    {% endif %}
    background-size: cover;
    background-position: bottom right;
    padding: 100px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .mts-home-hero .page-width {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-home-hero {
      padding: 80px 0;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .mts-home-hero .page-width {
      align-items: flex-start;
    }
  }

  #shopify-section-{{ section.id }} .mts-home-hero .mts-home-hero-content {
    padding: 0;
    margin-top: 48px;
  }

  #shopify-section-{{ section.id }} .mts-home-hero h1 {
    font-size: 72px;
    font-family: 'Source Sans 3', sans-serif;
    line-height: 1;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .mts-home-hero h1 .highlight-light-blue {
    color: var(--mts-secondary-color);
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-home-hero h1 {
      font-size: 48px;
    }
  }

  #shopify-section-{{ section.id }} .mts-home-hero h1,
  #shopify-section-{{ section.id }} .mts-home-hero-content p {
    color: #ffffff;
    font-family: 'Source Sans 3', sans-serif;
    margin: 0;
    text-wrap: pretty;
  }

  #shopify-section-{{ section.id }} .mts-home-hero-content p {
    font-size: 36px;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .mts-home-hero p {
      font-size: 28px;
    }
  }

  #shopify-section-{{ section.id }} .mts-home-hero-content .mts-home-hero-button {
    display: inline-block;
    background-color: var(--mts-secondary-color);
    color: #ffffff;
    border: none;
    padding: 12px 24px;
    border-radius: 140px;
    cursor: pointer;
    margin-top: 24px;
    font-size: 24px;
    font-family: 'Source Sans 3', sans-serif;
    transition: background-color 0.3s ease;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .mts-home-hero-content .mts-home-hero-button:hover {
    background-color: var(--mts-secondary-color-hover);
  }
{%- endstyle -%}

<div class="mts-home-hero" role="region" aria-labelledby="mts-home-hero-heading-{{ section.id }}">
  <div class="page-width">
    <h1 id="mts-home-hero-heading-{{ section.id }}">
      <span class="highlight-light-blue">{{ section.settings.heading_highlight }}</span><br>
      {{ section.settings.heading_line_2 }}
    </h1>
    <div class="mts-home-hero-content">
      <div class="rte">{{ section.settings.subheading }}</div>
      {% if section.settings.button_label != blank %}
        <a class="mts-home-hero-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MTS Home — Hero",
  "tag": "section",
  "class": "section-mts-home-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight (first line)",
      "default": "We know"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading remainder (after line break)",
      "default": "what keeps IT leaders up at night"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Most MSPs treat Macs like difficult Windows machines.<br><strong>We LOVE Macs.</strong></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Your Reality Check"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "MTS Home — Hero"
    }
  ]
}
{% endschema %}
